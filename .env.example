# Copy to .env and adjust. Never commit .env.
# In development, SECRET_KEY and DATA_ENCRYPTION_KEY are generated automatically into ./instance/.
# In production (LUMEN_ENV=production) both are REQUIRED.

LUMEN_ENV=development            # development | production

# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Several comma-separated keys allow rotation (newest first).
DATA_ENCRYPTION_KEY=

# Organization shown in the privacy notice
ORG_NAME=Your Organization
DPO_CONTACT=dpo@example.org

# Access control
REGISTRATION_ENABLED=1
REGISTRATION_CODE=               # if set, required to create an account (recommended)

# AI provider: offline (default, nothing leaves the server) | ollama (local) | groq (EXTERNAL, USA)
LLM_PROVIDER=offline
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b

# Retention (days)
REQUEST_RETENTION_DAYS=180
AUDIT_RETENTION_DAYS=365
CONTEST_RETENTION_DAYS=365

# Limits
MAX_PROMPT_CHARS=2000
ASK_RATE_LIMIT_PER_HOUR=30

# Behind a reverse proxy, set the number of trusted proxy hops (0 = none)
PROXY_FIX_HOPS=0
